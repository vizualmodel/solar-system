{
  "name": "solar-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:bridge": "vite --mode bridge --host 127.0.0.1 --port 5173 --strictPort",
    "bridge:init": "node scripts/init-bridge.mjs",
    "bridge": "node --import tsx bridge/server.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "data": "node scripts/fetch-data.mjs",
    "sky-data": "node scripts/fetch-sky.mjs",
    "rotation-data": "node scripts/fetch-rotation.mjs"
  },
  "dependencies": {
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "svelte-check": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
