{
  "id": "vizualmodel/solar-system",
  "name": "Solar System",
  "version": "0.1.0",
  "description": "Explore Solar Observatory and connect its scientific tools to an agent through VizualModel Bridge.",
  "applications": [
    {
      "id": "observatory",
      "name": "Solar Observatory",
      "url": "http://127.0.0.1:5180/",
      "mode": "area",
      "adapter": "bridge",
      "launch": {
        "command": "npm.cmd",
        "args": [
          "run",
          "application"
        ],
        "cwd": "."
      }
    }
  ],
  "references": [
    {
      "id": "guide",
      "name": "Model guide & scientific limitations",
      "kind": "Documentation",
      "url": "./README.md"
    },
    {
      "id": "horizons",
      "name": "NASA / JPL Horizons",
      "kind": "Data source",
      "url": "https://ssd.jpl.nasa.gov/horizons/"
    },
    {
      "id": "tools",
      "name": "Model tool reference",
      "kind": "Documentation",
      "url": "./docs/mcp-controls.md"
    }
  ],
  "tiles": [
    {
      "id": "simulator",
      "caption": "Solar System Simulator",
      "description": "Launch the existing Solar Observatory application.",
      "image": "./workspace/previews/solar-preview.jpg",
      "target": {
        "type": "application",
        "id": "observatory"
      },
      "mode": "area"
    },
    {
      "id": "positions",
      "caption": "Planetary Positions",
      "description": "Open the observatory. Use its timeline and camera controls to inspect positions.",
      "image": "./workspace/previews/positions-preview.jpg",
      "target": {
        "type": "application",
        "id": "observatory"
      },
      "mode": "area"
    },
    {
      "id": "moons",
      "caption": "Jupiter’s Moons",
      "description": "Connect Bridge and ask the model agent to frame Jupiter and its four main moons in this view.",
      "image": "./workspace/previews/moons-preview.jpg",
      "target": {
        "type": "application",
        "id": "observatory"
      },
      "mode": "area"
    }
  ]
}
