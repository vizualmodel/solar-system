  {
    "name": "scenarios",
    "description": "Application-owned reusable scenario prompts, separate from simulation state. List/get Markdown prompts; save a distilled, tested task as title + prompt. Saving does not run it. To replace an existing prompt, get its id/revision first and supply expectedRevision. Saving never runs a prompt. The model submits a scenario only through its explicitly connected Bridge conversation.",
    "operation": "control",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "save"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19000
        },
        "expectedRevision": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
]
